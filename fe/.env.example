# In sviluppo resta vuota: le chiamate partono relative (/api) e le inoltra il
# proxy di Vite. Su Render: indirizzo completo del backend, senza / finale.
#
#   VITE_API_URL=https://nosey-be.onrender.com
#
# Vite la legge al momento della BUILD: cambiarla richiede un nuovo deploy.
VITE_API_URL=

# Dati finti (MSW, src/mocks): in sviluppo rispondono agli endpoint degli eventi al posto
# del backend. Attivi di default; "false" per usare solo il backend vero.
# Non hanno effetto sulla build di produzione.
VITE_DATI_FINTI=
